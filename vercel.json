{
  "redirects": [
    {
      "source": "/p/:path*",
      "destination": "/post/:path*",
      "permanent": false
    },
    {
      "source": "/u/:path*",
      "destination": "/user/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/post/:id",
      "destination": "/api/post/:id"
    },
    {
      "source": "/user/:handle",
      "destination": "/api/user/:handle"
    },
    {
      "source": "/download",
      "destination": "/api/download"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
