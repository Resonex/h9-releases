{
  "redirects": [
    {
      "source": "/post/:path*",
      "destination": "/download",
      "permanent": false
    },
    {
      "source": "/p/:path*",
      "destination": "/download",
      "permanent": false
    },
    {
      "source": "/user/:path*",
      "destination": "/download",
      "permanent": false
    },
    {
      "source": "/u/:path*",
      "destination": "/download",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}
